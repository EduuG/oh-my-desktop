/* SakuraDesktopIcons - only desktop-specific overrides.
   Everything else follows the current Qt system style and palette. */

QWidget#DesktopWindow {
    background: transparent;
}

QWidget#DesktopScene {
    background: transparent;
}

/* Tooltips follow the current Qt palette */

QToolTip {
    background-color: palette(tooltip-base);
    color: palette(tooltip-text);
    border: 1px solid palette(mid);
    padding: 2px;
}

/* Properties Dialog banner */

#PropBanner {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 0,
        stop: 0 palette(highlight),
        stop: 1 palette(accent)
    );
}

#PropBannerText {
    color: palette(highlighted-text);
    font-weight: bold;
}